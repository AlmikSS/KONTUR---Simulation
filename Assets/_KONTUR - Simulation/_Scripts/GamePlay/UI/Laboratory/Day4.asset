  _replics:
  - Name: "\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u21164"
    Text: "\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u043C
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044F\u043C.
      \u0414\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F. \u041A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438
      \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u0434\u043B\u0438\u043D\u0438\u043B\u0438\u0441\u044C.
      \u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430 \u043A\u043E\u0436\u0438
      \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0430\u0441\u044C. \u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
      \u0443\u0447\u0430\u0441\u0442\u043A\u0438 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430,
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0435 \u043F\u043B\u043E\u0442\u043D\u0443\u044E
      \u0432\u043E\u043B\u043E\u043A\u043D\u0438\u0441\u0442\u0443\u044E \u0442\u043A\u0430\u043D\u044C."
    Image: {fileID: 0}
  - Name: "\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u21164"
    Text: "\u041D\u0430 \u0442\u0435\u043B\u0435 \u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u043E\u0433\u043E
      \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u044F\u0437\u043A\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E
      \u0447\u0451\u0440\u043D\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430.
      \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0435\u0433\u043E
      \u043F\u0440\u0438\u0440\u043E\u0434\u0443 \u043D\u0435 \u0441\u043C\u043E\u0433.
      \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u044F\u0436\u0451\u043B\u043E\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430,
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u043B\u0430
      \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u0440\u0435\u0437\u043A\u043E
      \u0432\u043E\u0437\u0440\u043E\u0441\u043B\u0430. \u0417\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
      \u043E\u043D \u0442\u0440\u0438\u0436\u0434\u044B \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u043E\u0442
      \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0445 \u0446\u0435\u043F\u0435\u0439."
    Image: {fileID: 0}
  - Name: "\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u21164"
    Text: "\u041F\u0435\u0440\u0441\u043E\u043D\u0430\u043B \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442
      \u043E \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u044B\u0445
      \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u0445 \u0432\u043D\u0443\u0442\u0440\u0438
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0438\u0446\u0443,
      \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u0443\u044E \u0436\u0430\u0436\u0434\u0443
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0435\u0435\u0441\u044F
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435, \u0431\u0443\u0434\u0442\u043E
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B
      \u0438\u0437\u043C\u0435\u043D\u044F\u044E\u0442 \u0441\u0432\u043E\u0451 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435.
      \u0421\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u044D\u0442\u0438\u043C\u0438
      \u0441\u043B\u0443\u0447\u0430\u044F\u043C\u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
      \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442."
    Image: {fileID: 0}
